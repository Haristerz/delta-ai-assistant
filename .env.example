# OpenAI-compatible settings (pointing to HuggingFace)
OPENAI_API_KEY=your-huggingface-token-here
OPENAI_BASE_URL=https://router.huggingface.co/v1
MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.3

# HuggingFace (same token as OPENAI_API_KEY)
HF_TOKEN=your-huggingface-token-here

# Database
DATABASE_URL=sqlite:///./delta.db

# JWT Auth
SECRET_KEY=generate-a-long-random-string-and-paste-here
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
